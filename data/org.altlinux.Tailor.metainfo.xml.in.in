<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
	<id>@APP_ID@</id>

	<name>Tailor</name>
	<developer id="org.altlinux">
		<name>Alexey Volkov</name>
	</developer>
	<summary>Create bootable drives</summary>

	<metadata_license>CC0-1.0</metadata_license>
	<project_license>GPL-3.0-or-later</project_license>

	<description>
		<p>
			Tailor is an application for writing OS images to USB drives.
			Pick an OS and edition from the built-in catalog (or supply your own ISO),
			pick a target drive, and Tailor downloads, verifies, and flashes it.
		</p>
	</description>

	<translation type="gettext">tailor</translation>

	<requires>
		<display_length compare="ge">360</display_length>
	</requires>

	<supports>
		<internet>offline-only</internet>
	</supports>

	<recommends>
		<control>pointing</control>
		<control>keyboard</control>
		<control>touch</control>
	</recommends>

	<branding>
		<color type="primary" scheme_preference="light">#cdab8f</color>
		<color type="primary" scheme_preference="dark">#4a2f1a</color>
	</branding>

	<launchable type="desktop-id">@APP_ID@.desktop</launchable>

	<url type="homepage">https://qualimock.space/projects/Tailor</url>
	<url type="bugtracker">https://altlinux.space/qualimock/Tailor/issues</url>
	<url type="translate">https://translate.alt-gnome.ru/projects/tailor/tailor/</url>
	<url type="help">https://altlinux.space/qualimock/Tailor/issues</url>
	<url type="vcs-browser">https://altlinux.space/qualimock/Tailor</url>
	<url type="contribute">https://altlinux.space/qualimock/Tailor</url>
	<url type="contact">https://matrix.to/#/@qualimock:alt-gnome.ru</url>

	<update_contact>qualimock@altlinux.org</update_contact>

	<content_rating type="oars-1.1" />

	<screenshots>
		<screenshot type="default">
			<image>https://altlinux.space/qualimock/Tailor/raw/commit/46b571fe7c754e094b589423e51839dbca2f30e1/data/screenshots/1-tailor.png</image>
			<caption>Tailor main page</caption>
		</screenshot>
		<screenshot>
			<image>https://altlinux.space/qualimock/Tailor/raw/commit/46b571fe7c754e094b589423e51839dbca2f30e1/data/screenshots/2-os-catalog.png</image>
			<caption>OS catalog</caption>
		</screenshot>
		<screenshot>
			<image>https://altlinux.space/qualimock/Tailor/raw/commit/46b571fe7c754e094b589423e51839dbca2f30e1/data/screenshots/3-os-page.png</image>
			<caption>OS page with detailed information</caption>
		</screenshot>
		<screenshot>
			<image>https://altlinux.space/qualimock/Tailor/raw/commit/46b571fe7c754e094b589423e51839dbca2f30e1/data/screenshots/4-flashing.png</image>
			<caption>Flashing process</caption>
		</screenshot>
		<screenshot>
			<image>https://altlinux.space/qualimock/Tailor/raw/commit/46b571fe7c754e094b589423e51839dbca2f30e1/data/screenshots/5-about.png</image>
			<caption>About dialog</caption>
		</screenshot>
	</screenshots>

	<releases>
		<release version="1.1.2" date="2026-09-25">
			<description>
				<p>Fixes:</p>
				<ul>
					<li>Use single FD for both writing and verifying. Some software could mount device between writing and verifying. Using single FD for both operations fixes it</li>
					<li>Retry any connection issue, not only stalled</li>
					<li>Bundle icons to application</li>
				</ul>
			</description>
		</release>
		<release version="1.1.1" date="2026-09-16">
			<description>
				<p>New - primary OS translations:</p>
				<p>Now Tailor detects OS id in &#x27;primary-os&#x27; field and put translatable primary OS title on DownloadPage. If id is not found, Tailor uses fallback &#x27;OS images&#x27;.</p>
				<p>Fixes:</p>
				<ul>
					<li>Flashing an OS detected from a local ISO file now writes that file directly</li>
					<li>Fixed device staying &quot;busy&quot; after cancelling a flash</li>
				</ul>
			</description>
		</release>
		<release version="1.1.0" date="2026-09-15">
			<description>
				<p>New - OS detection!</p>
				<p>Now Tailor can detect an operating system in your .iso file.</p>
				<p>Click &#x27;Install from File&#x27; and select an image - if Tailor knows that OS, it will navigate you to OsPage to display OS information.</p>
				<p>Then create downloadable USB as before.</p>
				<p>Changes:</p>
				<ul>
					<li>Tailor can now be translated conveniently! You can see translation progress in Weblate</li>
					<li>Tailor got Nightly release</li>
					<li>Set default window size to 600x680</li>
					<li>New branding scheme in metainfo</li>
					<li>Updated screenshots</li>
				</ul>
				<p>Fixes:</p>
				<ul>
					<li>Unknown versions are no longer displayed, e.g. for rolling-release distros like Arch</li>
					<li>OSes with single edition like GNU Guix does not display that single edition</li>
					<li>FlashPage title is now build from non-empty parts</li>
				</ul>
			</description>
		</release>
		<release version="1.0.0" date="2026-09-07" />
		<release version="0.1.1" date="2026-08-28" />
		<release version="0.1.0" date="2026-08-27" />
	</releases>
</component>

