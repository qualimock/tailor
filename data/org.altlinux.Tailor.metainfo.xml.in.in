<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
	<id>@APP_ID@</id>

	<name>Tailor</name>
	<developer id="org.altlinux">
		<name>Alexey Volkov</name>
	</developer>
	<summary>Create bootable drives</summary>

	<metadata_license>CC0-1.0</metadata_license>
	<project_license>GPL-3.0-or-later</project_license>

	<description>
		<p>
			Tailor is an application for writing OS images to USB drives.
			Pick an OS and edition from the built-in catalog (or supply your own ISO),
			pick a target drive, and Tailor downloads, verifies, and flashes it.
		</p>
	</description>

	<translation type="gettext">tailor</translation>

	<requires>
		<display_length compare="ge">360</display_length>
	</requires>

	<supports>
		<internet>offline-only</internet>
	</supports>

	<recommends>
		<control>pointing</control>
		<control>keyboard</control>
		<control>touch</control>
	</recommends>

	<branding>
		<!-- TODO: branding -->
		<color type="primary" scheme_preference="light">#ffb63f</color>
		<color type="primary" scheme_preference="dark">#c54400</color>
	</branding>

	<launchable type="desktop-id">@APP_ID@.desktop</launchable>

	<url type="homepage">https://qualimock.space/projects/Tailor</url>
	<url type="bugtracker">https://altlinux.space/qualimock/Tailor/issues</url>
	<url type="translate">https://altlinux.space/qualimock/Tailor/branch/main/po</url>
	<url type="help">https://altlinux.space/qualimock/Tailor/issues</url>
	<url type="vcs-browser">https://altlinux.space/qualimock/Tailor</url>
	<url type="contribute">https://altlinux.space/qualimock/Tailor</url>
	<url type="contact">https://matrix.to/#/@qualimock:alt-gnome.ru</url>

	<update_contact>qualimock@altlinux.org</update_contact>

	<content_rating type="oars-1.1" />

	<screenshots>
		<screenshot type="default">
			<image>https://altlinux.space/qualimock/Tailor/src/commit/cee267d64c8934afa7a153832f6e6deabc993ee0/data/screenshots/1-tailor.png</image>
			<caption>Tailor main page</caption>
		</screenshot>
		<screenshot>
			<image>https://altlinux.space/qualimock/Tailor/src/commit/cee267d64c8934afa7a153832f6e6deabc993ee0/data/screenshots/2-os-catalog.png</image>
			<caption>OS catalog</caption>
		</screenshot>
		<screenshot>
			<image>https://altlinux.space/qualimock/Tailor/src/commit/cee267d64c8934afa7a153832f6e6deabc993ee0/data/screenshots/3-os-page.png</image>
			<caption>OS page with detailed information</caption>
		</screenshot>
		<screenshot>
			<image>https://altlinux.space/qualimock/Tailor/src/commit/cee267d64c8934afa7a153832f6e6deabc993ee0/data/screenshots/4-flashing.png</image>
			<caption>Flashing process</caption>
		</screenshot>
		<screenshot>
			<image>https://altlinux.space/qualimock/Tailor/src/commit/cee267d64c8934afa7a153832f6e6deabc993ee0/data/screenshots/5-about.png</image>
			<caption>About dialog</caption>
		</screenshot>
	</screenshots>

	<releases>
		<release version="0.1.1" date="2026-08-28" />
		<release version="0.1.0" date="2026-08-27" />
	</releases>
</component>

