[Desktop Entry]
# Translators: app name should be translated
Name=Tailor
Comment=Create bootable drives
# Translators: keep number of ';'
Keywords=tailor;tale;teilor;usb;flash;writer;bootable;drive;iso;img;disk;image;
Exec=tailor
Icon=org.altlinux.Tailor
Terminal=false
Type=Application
Categories=GTK;GNOME;Utility;System;DiscBurning;
StartupNotify=true
X-GNOME-Gettext-Domain=tailor
X-Purism-FormFactor=Workstation;Mobile;
# Translators: Do NOT translate or transliterate this text (these are enum types)!
MimeType=application/x-iso9660-image;application/x-raw-disk-image;application/x-cd-image;application/x-xz;

