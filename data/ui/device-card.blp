using Gtk 4.0;

template $TailorDeviceCard: Box {
	styles [ "card" ]
	hexpand: true;

	Box {
		orientation: vertical;
		margin-top: 12;
		margin-bottom: 12;
		margin-start: 12;
		margin-end: 12;
		spacing: 12;

		Box {
			orientation: horizontal;
			spacing: 12;

			Image icon_image {
				pixel-size: 16;
				icon-name: "media-removable-symbolic";
				accessibility {
					label: _("Drive icon");
				}
			}

			Label name_label {
				styles [ "title-4" ]
				label: _("Drive name");
			}

			Label size_label {
				styles [ "title-4", "dimmed" ]
				halign: end;
				hexpand: true;
			}
		}

		Separator {}

		Box {
			orientation: horizontal;
			spacing: 12;

			Label {
				styles [ "dimmed" ]
				label: _("Address");
			}

			Label address_label {
				styles [ "dimmed" ]
				halign: end;
				hexpand: true;
			}
		}

		Box {
			orientation: horizontal;
			spacing: 12;

			Label {
				styles [ "dimmed" ]
				label: _("Filesystem");
			}

			Label filesystem_label {
				styles [ "dimmed" ]
				halign: end;
				hexpand: true;
			}
		}

		Box {
			orientation: vertical;
			margin-top: 12;
			spacing: 12;

			Button details_button {
				label: _("More in “Disks”");
				clicked => $on_more_in_disks_clicked ();
			}

			Button restore_button {
				styles [ "destructive-action" ]
				label: _("Restore");
			}
		}
	}
}
