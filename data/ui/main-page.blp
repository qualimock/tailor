using Gtk 4.0;
using Adw 1;

template $TailorMainPage : Adw.NavigationPage {
	title: _("Main page");

	child: Adw.BreakpointBin {
		width-request: 1;
		height-request: 1;

		Adw.Breakpoint {
			condition ("max-width: 599")

			setters {
				switcher_bar.reveal: true;
				header_bar.title-widget: null;
				cards_box.orientation: vertical;
				cards_box.homogeneous: false;
			}
		}

		child: Adw.ToolbarView {
			[top]
			Adw.HeaderBar header_bar {
				title-widget: Adw.ViewSwitcher {
					stack: stack;
					policy: wide;
				};

				[end]
				Button {
					styles [ "flat" ]

					tooltip-text: _("About");
					icon-name: "help-about-symbolic";
					action-name: "app.about";
				}
			}

			content: Adw.ViewStack stack {
				Adw.ViewStackPage {
					name: "write";
					title: _("Write");
					icon-name: "settings-symbolic";

					child: Adw.StatusPage {
						title: _("Welcome to Tailor!");
						description: _("Select image source to start.");
						icon-name: "org.altlinux.Tailor-symbolic";

						child: Adw.Clamp {
							maximum-size: 1024;

							child: Box cards_box {
								homogeneous: true;
								halign: center;
								spacing: 24;

								Button {
									styles [ "card" ]
									tooltip-text: _("Install From File");

									child: Box {
										orientation: vertical;
										margin-top: 24;
										margin-bottom: 24;
										margin-start: 24;
										margin-end: 24;
										spacing: 12;

										Image {
											styles [ "dim-label" ]

											margin-bottom: 6;

											pixel-size: 64;
											icon-name: "drawer-symbolic";
											accessible-role: presentation;
										}

										Label {
											styles [ "title-4" ]

											label: _("Install From File");
										}

										Label {
											styles [ "dim-label" ]

											wrap: true;
											justify: center;
											label: _("Load an .iso image from your device");
										}
									};
								}

								Button {
									styles [ "card" ]

									tooltip-text: _("Download and Write");
									action-name: "navigation.push";
									action-target: "'download-page'";

									child: Box {
										orientation: vertical;
										margin-top: 24;
										margin-bottom: 24;
										margin-start: 24;
										margin-end: 24;
										spacing: 12;

										Image {
											styles [ "dim-label" ]

											margin-bottom: 6;

											pixel-size: 64;
											icon-name: "download-symbolic";
											accessible-role: presentation;
										}

										Label {
											styles [ "title-4" ]

											label: _("Download and Write");
										}

										Label {
											styles [ "dim-label" ]

											wrap: true;
											justify: center;
											label: _("Download the required OS image directly in the application");
										}
									};
								}
							};
						};
					};
				}

				Adw.ViewStackPage {
					name: "devices";
					title: _("Devices");
					icon-name: "settings-symbolic";

					child: ScrolledWindow {
						child: Box {
							halign: center;

							Box devices {
								orientation: vertical;
								margin-top: 12;
								margin-bottom: 12;
								margin-start: 12;
								margin-end: 12;
								spacing: 12;
								visible: false;
							}

							Adw.StatusPage {
								icon-name: "drive-removable-media-symbolic";
								title: _("No Drives Found");
								description: _("Insert a drive to begin.");
								visible: bind devices.visible inverted;
							}
						};
					};
				}
			};

			[bottom]
			Adw.ViewSwitcherBar switcher_bar {
				stack: stack;
			}
		};
	};
}

