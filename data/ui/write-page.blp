using Gtk 4.0;
using Adw 1;

template $TailorWritePage : Adw.Bin {
	child: Adw.BreakpointBin {
		height-request: 1;
		width-request: 1;

		Adw.Breakpoint {
			condition ("max-width: 599")

			setters {
				cards_box.orientation: vertical;
			}
		}

		Adw.Breakpoint {
			condition ("min-width: 650")

			apply => $increase_cards_text_size ();
			unapply => $decrease_cards_text_size ();

			setters {
				from_file_icon.pixel-size: 128;
				download_icon.pixel-size: 128;
			}
		}

		child: Adw.StatusPage {
			title: _("Welcome to Tailor!");
			description: _("Select image source to start.");
			icon-name: "org.altlinux.Tailor-symbolic";

			child: Adw.Clamp {
				maximum-size: 1024;

				child: Box cards_box {
					homogeneous: true;
					halign: center;
					spacing: 24;

					Button {
						styles [ "card" ]
						clicked => $open_select_image_dialog();

						tooltip-text: _("Install From File");

						child: Box {
							orientation: vertical;
							margin-top: 24;
							margin-bottom: 24;
							margin-start: 24;
							margin-end: 24;
							spacing: 12;

							Image from_file_icon {
								styles [ "dimmed" ]

								margin-bottom: 6;

								pixel-size: 64;
								icon-name: "drawer-symbolic";
								accessible-role: presentation;
							}

							Label from_file_title {
								styles [ "title-4" ]

								label: _("Install From File");
							}

							Label from_file_subtitle {
								styles [ "dimmed" ]

								wrap: true;
								justify: center;
								label: _("Load an .iso image from your device");
							}
						};
					}

					Button {
						styles [ "card" ]

						tooltip-text: _("Download and Write");
						action-name: "navigation.push";
						action-target: "'download-page'";

						child: Box {
							orientation: vertical;
							margin-top: 24;
							margin-bottom: 24;
							margin-start: 24;
							margin-end: 24;
							spacing: 12;

							Image download_icon {
								styles [ "dimmed" ]

								margin-bottom: 6;

								pixel-size: 64;
								icon-name: "document-save-symbolic";
								accessible-role: presentation;
							}

							Label download_title {
								styles [ "title-4" ]

								label: _("Download and Write");
							}

							Label download_subtitle {
								styles [ "dimmed" ]

								wrap: true;
								justify: center;
								label: _("Download the required OS image directly in the application");
							}
						};
					}
				};
			};
		};
	};
}
