diff --git a/osinfo/osinfo_relocatable.h b/osinfo/osinfo_relocatable.h
new file mode 100644
index 0000000..2f73252
--- /dev/null
+++ b/osinfo/osinfo_relocatable.h
@@ -0,0 +1,84 @@
+/*
+ * libosinfo: Helpers for relocatable runtime paths
+ *
+ * Copyright (C) 2026
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library. If not, see
+ * <http://www.gnu.org/licenses/>.
+ */
+
+#pragma once
+
+#include <glib.h>
+
+#ifdef G_OS_WIN32
+# include <windows.h>
+#endif
+
+static inline gchar *
+osinfo_relocatable_dir(gconstpointer address,
+                       const gchar *fallback,
+                       const gchar *relative_dir)
+{
+#ifdef G_OS_WIN32
+    HMODULE module = NULL;
+    DWORD len = 0;
+    DWORD size = MAX_PATH;
+    wchar_t *module_path_utf16 = NULL;
+    gchar *module_path = NULL;
+    gchar *bindir = NULL;
+    gchar *prefix = NULL;
+    gchar *path = NULL;
+
+    if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS |
+                            GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                            (LPCWSTR)address,
+                            &module)) {
+        return g_strdup(fallback);
+    }
+
+    for (;;) {
+        module_path_utf16 = g_new(wchar_t, size);
+        len = GetModuleFileNameW(module, module_path_utf16, size);
+        if (len == 0) {
+            g_free(module_path_utf16);
+            return g_strdup(fallback);
+        }
+        if (len < size)
+            break;
+
+        g_free(module_path_utf16);
+        module_path_utf16 = NULL;
+        size *= 2;
+    }
+
+    module_path = g_utf16_to_utf8((const gunichar2 *)module_path_utf16,
+                                  -1, NULL, NULL, NULL);
+    g_free(module_path_utf16);
+    if (!module_path)
+        return g_strdup(fallback);
+
+    bindir = g_path_get_dirname(module_path);
+    prefix = g_path_get_dirname(bindir);
+    path = g_build_filename(prefix, relative_dir, NULL);
+
+    g_free(prefix);
+    g_free(bindir);
+    g_free(module_path);
+
+    return path;
+#else
+    return g_strdup(fallback);
+#endif
+}
